//! Data Runtime — listeners
//! Thin wrapper over canonrs_interactions_core::runtime::listeners
pub use canonrs_interactions_core::runtime::listeners::{
    listen, listen_document, listen_window, cleanup,
};

/// Convenience: get uid from element attribute "data-rs-uid"
pub fn uid_of(el: &web_sys::Element) -> Option<String> {
    el.get_attribute("data-rs-uid")
}
